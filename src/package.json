{
  "name": "dew",
  "version": "1.0.0",
  "description": "",
  "main": "gulpfile.js",
  "scripts": {
    "clean": "rimraf src/main/webapp/react/* && rimraf src/main/webapp/resources/*",
    "dev": "gulp",
    "pluck:react": "rimraf ./src/main/webapp/react/reports && mkdir -p ./src/main/webapp/react && cp -r ./react/reports/build ./src/main/webapp/react/reports",
    "build:react": "npm run --prefix ./react/reports build",
    "symlink:react": "npm run --prefix ./react/reports symlink",
    "build": "npm run clean && gulp build && npm run build:react && npm run pluck:react"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^6.7.6",
    "del": "^2.2.2",
    "flow-bin": "^0.45.0",
    "gulp": "^3.9.1",
    "gulp-clean": "^0.3.2",
    "gulp-cssmin": "^0.1.7",
    "gulp-iconfont": "^8.0.1",
    "gulp-iconfont-css": "^2.1.0",
    "gulp-postcss": "^6.3.0",
    "gulp-sass": "^2.3.2",
    "gulp-sequence": "^0.4.6",
    "gulp-style-modules": "^0.1.0",
    "gulp-symlink": "^2.1.4",
    "node-sass": "^3.13.1",
    "node-sass-import-once": "^1.2.0",
    "polymer-build": "^0.8.4",
    "postcss-viewport-units": "^0.1.2",
    "rimraf": "^2.6.2"
  }
}
