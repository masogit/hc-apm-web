<?xml version="1.0" encoding="UTF-8"?>

<beans:beans xmlns="http://www.springframework.org/schema/security" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:beans="http://www.springframework.org/schema/beans"
             xmlns:p="http://www.springframework.org/schema/p"
             xsi:schemaLocation="
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
		http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-3.1.xsd">

    <!-- public pages -->
    <http pattern="/login*.xhtml" security="none"/>
    <http pattern="/restful/*" security="none"/>
    <http pattern="/ws/*" security="none"/>
    <http pattern="/soap/*" security="none"/>
    <http pattern="/favicon.ico" security="none"/>
    <http pattern="/resources/*" security="none"/>
    <http pattern="/javax.*/**" security="none"/>
    <http pattern="/login.faces*" security="none"/>
    <http pattern="/error/*" security="none"/>
    <http pattern="/about.html" security="none"/>
    <http pattern="/portal/asset/info/specialAssetList.xhtml" security="none"/>
    <http pattern="/portal/woMgr/workOrderList.xhtml" security="none"/>
    <http pattern="/portal/woMgr/specialWorkOrderList.xhtml" security="none"/>
    <http pattern="/portal/pm/specialPmOrderListAll.xhtml" security="none"/>
    <http pattern="/portal/measuring/specialMeasuringResultMain.xhtml" security="none"/>
    <http pattern="/portal/asset/riskAssessment/specialAssetRiskAssessmentList.xhtml" security="none"/>
    <http pattern="/portal/asset/fileAttachment/specialList.xhtml" security="none"/>

    <beans:bean name="logoutHandler" class="com.ge.apm.view.sysutil.LogoutHandler" p:logoutSuccessUrl="/login.xhtml"/>

    <!-- secure pages -->
    <http auto-config="true" use-expressions="true">
        <form-login login-page="/login.xhtml" default-target-url="/home.xhtml" login-processing-url="/logincheck" always-use-default-target="true" authentication-failure-url="/login?login_error=1"/>
        <logout logout-url="/logout.xhtml" success-handler-ref="logoutHandler"/>
        <intercept-url pattern="/web/**" access="permitAll"/>

        <intercept-url pattern="/**/wechat/asset/createInfoDetail.xhtml**" access="permitAll"/>
        <intercept-url pattern="/**/wechat/**" access="permitAll"/>

        <!--APM管理-->
        <intercept-url pattern="/admin/uaa/siteInfo/List.xhtml" access="hasAnyRole('SuperAdmin','GeOp')"/>
        <intercept-url pattern="/admin/batchFile/batchFileList.xhtml"
                       access="hasAnyRole('SuperAdmin','GeOp','SiteAdmin','DataMaintainStaff','GEInternalStaff')"/>
        <intercept-url pattern="/admin/coilOpportunityImage/**"
                       access="hasAnyRole('DataMaintainStaff')"/>
        <intercept-url pattern="/portal/sr/opsreport/reportList.xhtml"
                       access="hasAnyRole('SuperAdmin','SiteAdmin','DataMaintainStaff')"/>
        <intercept-url pattern="/portal/fealert/report/List.xhtml"
                       access="hasAnyRole('SuperAdmin','SiteAdmin','DataMaintainStaff')"/>

        <intercept-url pattern="/admin/IBUInfoImage/**"
                       access="hasAnyRole('DataMaintainStaff')"/>
        <intercept-url pattern="/admin/USOptionImage/**"
                       access="hasAnyRole('DataMaintainStaff')"/>
        <intercept-url pattern="/admin/probeRecommendImage/**"
                       access="hasAnyRole('DataMaintainStaff')"/>

        <intercept-url pattern="/home.xhtml" access="isAuthenticated()"/>
        <intercept-url pattern="/api/**" access="isAuthenticated()"/>
        <intercept-url pattern="/sysadmin/**" access="hasRole('SuperAdmin')"/>
        <intercept-url pattern="/admin/adminCache.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/admin/adminConsole.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/admin/adminConsolePm.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/admin/AssetGroupSecondaryImport.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/admin/sql.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/admin/sqlExprot.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/admin/TenantPasswordSetup.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>

        <!-- 首页 -->
        <intercept-url pattern="/homeHead**" access="hasAnyRole('SuperAdmin','HospitalHead')"/>
        <intercept-url pattern="/homeAssetHead**" access="hasAnyRole('SuperAdmin','AssetHead')"/>
        <intercept-url pattern="/homeAssetStaff**" access="hasAnyRole('SuperAdmin','AssetStaff','zkbDealerFE','zkbDealerSales')"/>
        <intercept-url pattern="/homeDeptHead**" access="hasAnyRole('SuperAdmin','DeptHead')"/>
        <intercept-url pattern="/homeNurse**" access="hasAnyRole('SuperAdmin','NursingStaff', 'ClinicalStaff','DeptHead')"/>

        <!-- 系统管理 -->
        <intercept-url pattern="/admin/uaa/orgInfo/List.xhtml" access="hasAnyRole('SuperAdmin')"/>
        <intercept-url pattern="/portal/loginAs/List.xhtml" access="hasAnyRole('SuperAdmin')"/>
        <intercept-url pattern="/portal/asset/assetTag/TagSubscriberAll.xhtml" access="@customPermissionEvaluator.hasPermission(authentication, request, 'REPAIR_MESSAGE_VIEW') or hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/>
        <intercept-url pattern="/portal/asset/qrCode/qrCodeLibList.xhtml" access="hasAnyRole('SuperAdmin')"/>
        <intercept-url pattern="/portal/asset/bulkEdit/AssetBulkEditSite.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','AssetHead')"/><!-- 资产批量修改院区-->
        <intercept-url pattern="/portal/asset/qrCode/qrCodeTemplate.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/><!-- 二维码模板管理 -->
        <intercept-url pattern="/portal/asset/ownerSetting/ownerConfigMain.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/><!-- 维修责任人设置 -->
        <intercept-url pattern="/portal/asset/tag/List.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/><!-- 设备标签管理类 -->
        <intercept-url pattern="/portal/config/workFlowConfig/List.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/>
        <intercept-url pattern="/portal/asset/customConfig/CustomConfig.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/>
        <intercept-url pattern="/portal/config/attribute/List.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/>
        <intercept-url pattern="/portal/config/msgconfig_edit.xhtml" access="hasAnyRole('SuperAdmin','ITAdmin','LocalITAdmin')"/>
        <intercept-url pattern="/portal/asset/qrCode/hospital/qrCodeLibList.xhtml" access="hasAnyRole('ITAdmin','LocalITAdmin')"/><!-- 二维码生成 -->
        <intercept-url pattern="/portal/asset/captureData/captureDataMessageList.xhtml" access="hasAnyRole('SuperAdmin','SiteAdmin')"/>
        <intercept-url pattern="/portal/asset/contract/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'ASSET_CONTRACT_')"/>
        <intercept-url pattern="/account-dashboard/#/" access="hasAnyRole('SuperAdmin')"/>

        <intercept-url pattern="/portal/uaa/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'CONFIG_') or hasAnyRole('SuperAdmin','ITAdmin','SiteAdmin','LocalITAdmin')"/>
        <intercept-url pattern="/portal/insp/checkListList**" access="hasAnyRole('SuperAdmin','ITAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales','LocalITAdmin')"/> <!-- 巡检条目配置 -->
        <intercept-url pattern="/portal/i18n/FieldCodeType.xhtml**" access="hasAnyRole('SuperAdmin','ITAdmin','AssetHead','LocalITAdmin')"/> <!-- 系统编码配置 -->

        <!-- 设备档案 -->
        <intercept-url pattern="/portal/asset/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'ASSET_') or hasAnyRole('SuperAdmin','HospitalHead','AssetHead','DeptHead','AssetStaff','zkbDealerFE','zkbDealerSales', 'ClinicalStaff','ITAdmin','LocalITAdmin','MVSAdmin','MVSFE','NursingStaff')"/>

        <!-- 维修管理 -->
        <intercept-url pattern="/portal/wo/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'REPAIR_') or hasAnyRole('SuperAdmin','HospitalHead','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales','DeptHead')"/> <!-- 维修管理 -->
        <intercept-url pattern="/portal/sr/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'REPAIR_') or hasAnyRole('SuperAdmin','HospitalHead','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 维修管理 -->

        <!-- 设备监控 -->
        <intercept-url pattern="/portal/analysis/assetStatus**" access="hasAnyRole('SuperAdmin','HospitalHead','AssetHead','DeptHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 状态监控 -->
        <intercept-url pattern="/portal/analysis/assetMaintenance**" access="hasAnyRole('SuperAdmin','HospitalHead','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 维修事件统计 -->
        <intercept-url pattern="/portal/analysis/assetUsage**" access="hasAnyRole('SuperAdmin','HospitalHead','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales','DeptHead')"/> <!-- 使用情况统计 -->
        <intercept-url pattern="/portal/analysis/assetScan**" access="hasAnyRole('SuperAdmin','HospitalHead','AssetHead','DeptHead')"/> <!-- 扫描详情统计 -->
        <intercept-url pattern="/portal/analysis/staffPerf**" access="hasAnyRole('SuperAdmin','HospitalHead','AssetHead')"/>

        <!-- 预防维护(供应商) -->
        <intercept-url pattern="/portal/pm/supplier/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'SUPPLIER_') or hasAnyRole('SupplierFE','SupplierAdmin')"/> <!-- 保养工作台 -->

        <!-- 预防维护 -->
        <intercept-url pattern="/portal/insp/**" access="hasAnyRole('SuperAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 巡检管理 -->

        <intercept-url pattern="/portal/pm/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'MAINTAIN_') or hasAnyRole('DeptHead','ClinicalStaff','SuperAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales','HospitalHead')"/> <!-- 保养管理 -->
        <intercept-url pattern="/portal/metering/**" access="hasAnyRole('SuperAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 计量管理 -->
        <intercept-url pattern="/portal/qc/**" access="hasAnyRole('SuperAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 质控管理 -->
        <intercept-url pattern="/portal/adverseEvent/**" access="hasAnyRole('SuperAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 不良事件上报 -->
        <intercept-url pattern="/portal/analysis/mt.xhtml**" access="hasAnyRole('SuperAdmin','AssetHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/><!-- 计量模板 -->

        <!-- 知识文档 -->
        <intercept-url pattern="/portal/asset/fileAttachment/**" access="@customPermissionEvaluator.hasPermission(authentication, request, 'KNOWLEDGE_') or hasAnyRole('SuperAdmin','HospitalHead','AssetHead','DeptHead','AssetStaff','zkbDealerFE','zkbDealerSales')"/> <!-- 文档管理 -->

        <!-- 绩效分析 -->
        <intercept-url pattern="/portal/analysis/assetPerf**" access="hasAnyRole('SuperAdmin','HospitalHead', 'AssetHead', 'DeptHead')"/> <!-- 绩效分析 -->
        <intercept-url pattern="/portal/analysis/assetForecast**" access="hasAnyRole('SuperAdmin','HospitalHead', 'AssetHead')"/> <!-- 绩效预测 -->
        <intercept-url pattern="/portal/analysis/assetDecision**" access="hasAnyRole('SuperAdmin','HospitalHead', 'AssetHead')"/> <!-- 辅助决策 -->

        <intercept-url pattern="/portal/tenant/TenantOptionConfig.xhtml" access="hasAnyRole('SuperAdmin')"/> <!-- 租户选项配置 -->
        <intercept-url pattern="/portal/transactionManage/deptTransactionManage.xhtml" access="@customPermissionEvaluator.hasPermission(authentication, request, 'PERFORMANCE_DEPT_MANAGE_EDIT') or hasAnyRole('HospitalHead','AssetHead','AssetStaff')"/> <!-- 文档管理 -->

        <!-- 护士站 -->
        <!-- <intercept-url pattern="/portal/nurseSite/**" access="hasAnyRole('SuperAdmin','HospitalHead', 'NursingStaff')"/> -->
        <!--设备调剂-->



        <intercept-url pattern="/**/*.xhtml*" access="isAuthenticated()"/>
        <!---->
        <access-denied-handler error-page="/accessdeniedzh.xhtml"/>
        <!--
        <port-mappings>
        <port-mapping http="80" https="443"/>
        <port-mapping http="8080" https="443"/>
        </port-mappings>
        -->
    </http>
</beans:beans>
