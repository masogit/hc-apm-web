<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.UserMapper">
    <select id="selectUser" resultType="com.ge.apm.domain.UserAccount">
        select * from user_account
    </select>
    <select id="selectUser2" resultType="com.ge.apm.domain.UserAccount">
        select u.* from user_account u,user_role r 
        <where>${ew.sqlSegment}</where>
    </select>
    

    <resultMap type="com.ge.apm.domain.UserAccount" id="userBean" autoMapping="true">
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <collection property="userRoleList" ofType="com.ge.apm.domain.UserRole">
            <result column="id" property="userId"/>
            <result column="rid" property="roleId"/>
            <result column="rname" property="roleName"/>
        </collection>
    </resultMap>

    <select id="queryUserDetail" resultMap="userBean">
        select u.id, u.name, r.role_id as rid, sr.name as rname from user_account u 
        join user_role r on u.id = r.user_id 
        join sys_role sr on r.role_id=sr.id
        <where>${ew.sqlSegment}</where>
    </select>
    
    
</mapper>