<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.NurseSiteMaintainHistoryMapper">

    <resultMap type="com.ge.apm.domain.NurseSiteMaintainHistory" id="maintainBean" autoMapping="true">
        <result column="id" property="id"/>
        <result column="create_date" property="createDate"/>
        <result column="modify_date" property="modifyDate"/>
        <result column="check_date" property="checkDate"/>
        <result column="schedule_date" property="scheduleDate"/>
        <result column="tenant_uid" property="tenantUID"/>
        <result column="institution_uid" property="institutionUID"/>
        <result column="hospital_uid" property="hospitalUID"/>
        <result column="site_uid" property="siteUID"/>
        <result column="create_by" property="createByUid"/>
        <result column="modify_by" property="modifyByUid"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="is_finish" property="isFinish"/>
        <result column="config_id" property="configId"/>
        <result column="signature_id" property="signatureId"/>
        <result column="signature_source_type" property="signatureSourceType"/>
        <result column="sequence" property="sequence"/>
        <result column="clinical_dept_uid" property="clinicalDeptUID"/>
        <result column="clinical_dept_name" property="clinicalDeptName"/>
    </resultMap>

    <select id="findJoinAssetList" resultMap="maintainBean">
        select nsm.* from nurse_site_maintain_history nsm left join nurse_site_maintain_item_history  nsmi on nsm.id = nsmi.parent_id left join asset_info ai on nsmi.asset_uid = ai.uid
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="searchMaintainHistory" resultMap="maintainBean">
        select nsm.* from nurse_site_maintain_history nsm
        <where>
            <choose>
                <when test="assetTypes != null and assetTypes.size > 0">
                    <include refid="queryConfigIds"/>
                </when>
                <otherwise>
                    <if test="scheduleDateStart != null">
                        and nsm.schedule_date >= #{scheduleDateStart}
                    </if>
                    <if test="scheduleDateEnd != null">
                        and nsm.schedule_date &lt;= #{scheduleDateEnd}
                    </if>
                    <if test="tenantUid != null">
                        and nsm.tenant_uid = #{tenantUid}
                    </if>
                    <if test="siteUid != null">
                        and nsm.site_uid = #{siteUid}
                    </if>
                    <if test="deptUid != null">
                        and nsm.clinical_dept_uid = #{deptUid}
                    </if>
                    <if test="assetDeptUid != null">
                        and exists (select 1 from nurse_site_maintain_item_history nsmi2 join asset_info ai2 on nsmi2.asset_uid = ai2.uid where nsmi2.parent_id = nsm.id and ai2.asset_dept_uid = #{assetDeptUid})
                    </if>
                    <if test="configId != null">
                        and nsm.config_id = #{configId}
                    </if>
                    <if test="status != null">
                        and nsm.status in ${status}
                    </if>
                    <if test="orgUidList != null and orgUidList.size > 0">
                        and (
                        nsm.site_uid in
                        <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                            #{item}
                        </foreach>
                        or nsm.institution_uid in
                        <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                            #{item}
                        </foreach>
                        or nsm.hospital_uid in
                        <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                            #{item}
                        </foreach>
                        or nsm.clinical_dept_uid in
                        <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                            #{item}
                        </foreach>
                        )
                    </if>
                </otherwise>
            </choose>
        </where>
    </select>

    <sql id="queryConfigIds">
        and nsm.id in (
        select nsmi.parent_id from nurse_site_maintain_item_history nsmi join asset_info ai on nsmi.asset_uid = ai.uid
        <where>
            <if test="scheduleDateStart != null">
                and nsmi.schedule_date >= #{scheduleDateStart}
            </if>
            <if test="scheduleDateEnd != null">
                and nsmi.schedule_date &lt; #{scheduleDateEnd}
            </if>
            <if test="tenantUid != null">
                and ai.tenant_uid = #{tenantUid}
            </if>
            <if test="siteUid != null">
                and ai.site_uid = #{siteUid}
            </if>
            <if test="deptUid != null">
                and ai.clinical_dept_uid = #{deptUid}
            </if>
            <if test="assetDeptUid != null">
                and ai.asset_dept_uid = #{assetDeptUid}
            </if>
            <if test="orgUidList != null and orgUidList.size > 0">
                and (
                ai.site_uid in
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                or ai.institution_uid in
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                or ai.hospital_uid in
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                or ai.clinical_dept_uid in
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                )
            </if>
            <if test="assetTypes != null and assetTypes.size > 0">
                and ai.asset_type in
                <foreach item="item" collection="assetTypes" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
            </if>
        </where>
        )
    </sql>

</mapper>