<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.NurseSiteMaintainItemMapper">

    <resultMap type="com.ge.apm.domain.NurseSiteMaintainItem" id="maintainBean" autoMapping="true">
        <result column="id" property="id"/>
        <result column="create_date" property="createDate"/>
        <result column="modify_date" property="modifyDate"/>
        <result column="check_date" property="checkDate"/>
        <result column="schedule_date" property="scheduleDate"/>
        <result column="create_by" property="createByUid"/>
        <result column="modify_by" property="modifyByUid"/>
        <result column="parent_id" property="parentId"/>
        <result column="asset_uid" property="assetUid"/>
        <result column="status" property="status"/>
        <result column="is_finish" property="isFinish"/>
        <result column="asset_uid" property="assetUid"/>
        <result column="clinical_dept_uid" property="clinicalDeptUID"/>
        <result column="clinical_dept_name" property="clinicalDeptName"/>
        <result column="name" property="name"/>
        <result column="config_id" property="configId"/>
        <result column="signature_id" property="signatureId"/>
        <result column="signature_source_type" property="signatureSourceType"/>
        <result column="sequence" property="sequence"/>
        <result column="comment" property="comment"/>
    </resultMap>

    <select id="findJoinAssetList" resultMap="maintainBean">
        select nsmi.* from nurse_site_maintain_item nsmi left join asset_info ai on nsmi.asset_uid = ai.uid
        <where>${ew.sqlSegment}</where> order by id
    </select>
    <sql id="filtersSql">
        <if test="tenantUid != null">
            and nsm.tenant_uid = #{tenantUid}
        </if>
        <if test="siteUid != null">
            and ai.site_uid = #{siteUid}
        </if>
        <if test="deptUid != null">
            and ai.clinical_dept_uid = #{deptUid}
        </if>
        <if test="assetDeptUid != null">
            and ai.asset_dept_uid = #{assetDeptUid}
        </if>
        <if test="maintainName != null and maintainName != ''">
            and nsm.name like concat('%', #{maintainName}, '%')
        </if>
        <if test="assetName != null and assetName != ''">
            and ai.name like concat('%', #{assetName}, '%')
        </if>
        <if test="serialNum != null and serialNum != ''">
            and ai.serial_num like concat('%', #{serialNum}, '%')
        </if>
        <if test="qrCode != null and qrCode != ''">
            and ai.qr_code like concat('%', #{qrCode}, '%')
        </if>
        <if test="clinicalDeptName != null and clinicalDeptName != ''">
            and ai.clinical_dept_name like concat('%', #{clinicalDeptName}, '%')
        </if>
        <if test="usingDeptName != null and usingDeptName != ''">
            and o2.name like concat('%', #{usingDeptName}, '%')
        </if>
        <if test="checkDateStart != null">
            and nsm.check_date >= #{checkDateStart}
        </if>
        <if test="checkDateEnd != null">
            and nsm.check_date &lt;= #{checkDateEnd}
        </if>
        <if test="orgUidList != null and orgUidList.size > 0">
            and (
            ai.site_uid in
            <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                #{item}
            </foreach>
            or ai.clinical_dept_uid in
            <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                #{item}
            </foreach>
            )
        </if>
    </sql>
    <!-- Query daily inspection items with attachments, joining asset_info and nurse_site_maintain -->
    <select id="searchMaintainItemsWithAttachment" resultType="java.util.Map">
        select
            nsmi.id as "itemId",
            nsmi.parent_id as "maintainId",
            nsm.name as "maintainName",
            ai.name as "assetName",
            ai.serial_num as "serialNum",
            ai.qr_code as "qrCode",
            ai.clinical_dept_name as "clinicalDeptName",
            o2.name as "usingDeptName",
            nsm.check_date as "checkDate",
            nsm.schedule_date as "scheduleDate",
            nsm.status as "status",
            nsm.sequence as "sequence"
        from nurse_site_maintain_item nsmi
        inner join nurse_site_maintain nsm on nsmi.parent_id = nsm.id
        inner join asset_info ai on nsmi.asset_uid = ai.uid
        left join org_info o2 on ai.asset_dept_uid = o2.uid
        where exists (
            select 1 from v2_blob_object vbo
            where vbo.bo_uuid = nsmi.id
        )
        <include refid="filtersSql" />
        order by nsm.check_date desc
        limit #{pageSize} offset #{pageNum}
    </select>
    <select id="searchMaintainItemsWithAttachmentCount" resultType="int">
        select count(*)
        from nurse_site_maintain_item nsmi
                 inner join nurse_site_maintain nsm on nsmi.parent_id = nsm.id
                 inner join asset_info ai on nsmi.asset_uid = ai.uid
                 left join org_info o2 on ai.asset_dept_uid = o2.uid
        where exists (
            select 1 from v2_blob_object vbo
            where vbo.bo_uuid = nsmi.id
        )
        <include refid="filtersSql" />
    </select>

</mapper>