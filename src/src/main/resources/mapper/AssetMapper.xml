    <select id="selectMeasureResult" resultMap="assetBean">
        SELECT ai.id,
        ai.uid,
        ai.name,
        ai.serial_num,
        ai.financing_num,
        ai.qr_code,
        ai.function_type,
        ai.asset_group,
        ai.clinical_dept_name,
        ai.asset_dept_uid,
        ai.measure_grade,
        ai.measuring_item_category,
        mcd.certificate_no,
        mcd.status,
        mcd.type measuring_type,
        mcd.check_company last_check_company,
        ai.last_metering_date,
        ai.next_metering_date  as next_metering_date ,
        mcd.check_date,
        mcd.check_person,
        mcd.id as bo_uuid,
        mcd.created_by as upload_user_id,
        mcd.certificate_type,
        mcd.validity_months,
        ROUND(ai.metering_cycle / 12.0, 1) as measure_cycle,
        ua.name as upload_user_name,
        case when o.cu is not null then '是' else '否' end as exist_file_flag
        FROM asset_info ai
        INNER JOIN measuring_certificate_detail mcd ON mcd.asset_uid = ai.uid
        LEFT JOIN user_account ua ON mcd.created_by = ua.uid
        left  join (select count(*) cu, bo_uuid from v2_blob_object where bo_type = 'Measuring' group by bo_uuid) o on o.bo_uuid = mcd.id
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="selectMeasureUnpairedResult" resultMap="assetBean">
        SELECT mcd.id uid,
        mcd.asset_name as name,
        mcd.certificate_no,

        mcd.asset_model function_type,

        mcd.asset_manufacturer  manufacture,
        mcd.asset_sn   serial_num,
        mcd.status,
        mcd.type measuring_type,
        mcd.check_company last_check_company,

        CASE WHEN mcd.certificate_type = 2 THEN NULL ELSE mcd.valid_date_to END next_metering_date,
        mcd.check_date,
        mcd.check_person,
        mcd.department  department,
        mcd.id as bo_uuid,
        mcd.created_by as upload_user_id,
        mcd.certificate_type,
        ua.name as upload_user_name,
        case when o.cu is not null then '是' else '否' end as exist_file_flag
        FROM  measuring_certificate_detail mcd
        LEFT JOIN user_account ua ON mcd.created_by = ua.uid
        left  join (select count(*) cu, bo_uuid from v2_blob_object where bo_type = 'Measuring' group by bo_uuid) o on o.bo_uuid = mcd.id
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="findAssetByMaintainConfigParentId" resultType="com.ge.apm.domain.AssetInfo">
        select ai.* from asset_info ai left join nurse_site_maintain_config_item nsmci on ai.uid = nsmci.asset_uid
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="findAssetByMaintainConfigJNParentId" resultType="com.ge.apm.domain.AssetInfo">
        select ai.* from asset_info ai left join nurse_site_maintain_config_item_jn nsmci on ai.uid = nsmci.asset_uid
        <where>${ew.sqlSegment}</where>
    </select>
    <select id="toBeTerminatedList" resultType="com.ge.apm.domain.AssetInfo">
        SELECT
            ai.*,
            al.modify_time AS terminateOperationDate,
            al.modify_by AS terminateOperation,
            ai.make_short_name as makerShortName,
            wo.id AS workOrderId,
            sc.business_number AS assetScrapId
        FROM
            asset_info ai
        LEFT JOIN (
            SELECT
                *, row_number()over(partition by asset_uid order by create_time desc)
            FROM
                asset_lifecycle
            WHERE current_status = 4 AND tenant_uid = #{tenantUid}
        ) al ON ai.uid = al.asset_uid AND al.row_number = 1
        LEFT JOIN (
            SELECT
                id, asset_id, row_number()over(partition by asset_id order by created_date desc)
            FROM
                v2_work_order
            WHERE tenant_uid = #{tenantUid} AND status = 1
        ) wo ON ai.id = wo.asset_id AND wo.row_number = 1
        left join  asset_scrap sc on ai.asset_scrap_id = sc.id
        <include refid="queryCondition"/>
        <if test="orderBy!=null">
           ${orderBy}
        </if>
        LIMIT #{page} OFFSET #{offset}
    </select>

    <select id="toBeTerminatedListCount" resultType="long">
        select  count(*) from asset_info ai
        LEFT JOIN (
            SELECT
            *, row_number()over(partition by asset_uid order by create_time desc)
            FROM
            asset_lifecycle
            WHERE current_status = 4 AND tenant_uid = #{tenantUid}
            ) al ON ai.uid = al.asset_uid AND al.row_number = 1
        LEFT JOIN (
            SELECT
                id, asset_id, row_number()over(partition by asset_id order by created_date desc)
            FROM
                v2_work_order
            WHERE tenant_uid = #{tenantUid} AND status = 1
        ) wo ON ai.id = wo.asset_id AND wo.row_number = 1
        left join  asset_scrap sc on ai.asset_scrap_id = sc.id
        <include refid="queryCondition"/>

    </select>

    <select id="findByParam" resultMap="assetBean">
        select ai.id, ai.uid, ai.name, ai.status, ai.tenant_uid, ai.institution_uid, ai.hospital_uid, ai.site_uid, ai.financing_num, ai.serial_num, ai.depart_num, ai.qr_code, ai.asset_dept_uid, ai.clinical_dept_uid from org_info oi, user_org uo, asset_info ai
        <where>
            uo.user_uid = #{userUid}
            AND ai.tenant_uid = #{tenantUid}
            AND uo.org_uid IN ( oi.tenant_uid, oi.hospital_uid, oi.site_uid, oi.institution_uid, oi.uid )
            AND oi.org_type = 3
            AND oi.uid= ai.site_uid
            and ai.is_deleted='false' and ai.is_valid='true'
            <if test="siteUid != null">
                and ai.site_uid = #{siteUid}
            </if>
            <if test="clinicalDeptUid != null">
                and ai.clinical_dept_uid = #{clinicalDeptUid}
            </if>
            <if test="assetDeptUid != null">
                and ai.asset_dept_uid = #{assetDeptUid}
            </if>
            <if test="assetGroup != null">
                and ai.asset_group = #{assetGroup}
            </if>
            <if test="oneSearchStr != null">
                and (ai.name like concat('%',#{oneSearchStr},'%') or ai.depart_num like concat('%',#{oneSearchStr},'%') or ai.financing_num like concat('%',#{oneSearchStr},'%') or ai.qr_code like concat('%',#{oneSearchStr},'%') or ai.serial_num like concat('%',#{oneSearchStr},'%') )
            </if>
        </where>
        limit 1000 offset 0
    </select>

