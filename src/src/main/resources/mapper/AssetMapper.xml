    <select id="queryAssetInfo" resultMap="assetBean">


        select

        ai.id,
        ai.uid,
        ai.name,
        ai.serial_num,
        ai.financing_num,
        ai.qr_code,
        ai.function_type,
        ai.asset_group,
        ai.clinical_dept_name,
        ai.measure_grade,
        ai.measuring_item_category,
        ai.make_short_name ,
        ai.manufacture,
        ai.asset_classification32



            from asset_info       ai
        <where>
            ai.tenant_uid = #{tenantUid}
            and ai.site_uid=#{siteUid}
            <if test="clinicalDeptUid != null">
                AND ai.clinical_dept_uid =#{clinicalDeptUid}
            </if>
            <if test="assetDeptUid != null">
                AND ai.asset_dept_uid =#{assetDeptUid}
            </if>
            <if test="name != null">
                AND ai.name like concat('%',#{name},'%')
            </if>

            <if test="functionType != null">
                AND ai.function_type like concat('%',#{functionType},'%')
            </if>

            <if test="makerShortName != null">
                AND ai.make_short_name like concat('%',#{makerShortName},'%')
            </if>
            <if test="manufacture != null">
                AND ai.manufacture like concat('%',#{manufacture},'%')
            </if>
        </where>

    </select>
    <select id="selectUnMeasureResult" resultType="com.ge.apm.domain.AssetInfo">

        SELECT ai.*
        FROM asset_info ai
        <where>${ew.sqlSegment}</where>
    </select>


</mapper>