                    #{item}
                </foreach>
                OR ai.site_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.clinical_dept_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.asset_dept_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.tenant_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                )
            </if>
            <if test="oneSearchStr != null">
                AND (
                  ai.name like concat('%',#{oneSearchStr},'%')
                  or
                  ai.name_py_code like concat('%',#{oneSearchStr},'%')
                  or
                  ai.depart_num like concat('%',#{oneSearchStr},'%')
