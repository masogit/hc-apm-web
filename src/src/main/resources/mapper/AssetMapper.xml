<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.AssetInfoMapper">

    <resultMap type="com.ge.apm.domain.AssetInfo" id="assetBean" autoMapping="true">
        <result column="id" property="id"/>
        <result column="uid" property="uid"/>
        <result column="name" property="name"/>
        <result column="serial_num" property="serialNum"/>
        <result column="financing_num" property="financingNum"/>
        <result column="qr_code" property="qrCode"/>
        <result column="function_type" property="functionType"/>
        <result column="asset_group" property="assetGroup"/>
        <result column="clinical_dept_name" property="clinicalDeptName"/>
        <result column="measure_grade" property="measureGrade"/>
        <result column="measuring_item_category" property="measuringItemCategory"/>
        <result column="certificate_no" property="meteringNO"/>
        <result column="status" property="verificationConclusion"/>
        <result column="measuring_type" property="measuringType"/>
        <result column="last_check_company" property="lastCheckCompany"/>
        <result column="last_metering_date" property="lastMeteringDate"/>
        <result column="next_metering_date" property="nextMeteringDate"/>
        <result column="check_date" property="checkDate"/>
        <result column="bo_uuid" property="boUuid"/>
    </resultMap>

    <select id="selectMeasureResult" resultMap="assetBean">
        SELECT ai.id,
        ai.uid,
        ai.name,
        ai.serial_num,
        ai.financing_num,
        ai.qr_code,
        ai.function_type,
        ai.asset_group,
        ai.clinical_dept_name,
        ai.measure_grade,
        ai.measuring_item_category,
        mcd.certificate_no,
        mcd.status,
        ai.measuring_type,
        ai.last_check_company,
        ai.last_metering_date,
        ai.next_metering_date,
        mcd.check_date,
        mcd.id as bo_uuid
        FROM asset_info ai
        INNER JOIN measuring_certificate_detail mcd ON mcd.asset_uid = ai.uid
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="findAssetByMaintainConfigParentId" resultType="com.ge.apm.domain.AssetInfo">
        select ai.* from asset_info ai left join nurse_site_maintain_config_item nsmci on ai.uid = nsmci.asset_uid
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="findAssetByMaintainConfigJNParentId" resultType="com.ge.apm.domain.AssetInfo">
        select ai.* from asset_info ai left join nurse_site_maintain_config_item_jn nsmci on ai.uid = nsmci.asset_uid
        <where>${ew.sqlSegment}</where>
    </select>
    <select id="toBeTerminatedList" resultType="com.ge.apm.domain.AssetInfo">

        select  ai.*,al.modify_time as terminateOperationDate ,al.modify_by terminateOperation from asset_info ai left join (select a1.* from  asset_lifecycle  a1 inner join  ( select max(create_time) create_time,asset_uid from asset_lifecycle  where   current_status = 4  group by    asset_uid  )  a2 on     a1.asset_uid=a2.asset_uid and a1.create_time=a2.create_time) al on ai.uid=al.asset_uid

        <include refid="queryCondition"/>

       <if test="orderBy!=null">
           ${orderBy}
       </if>
        LIMIT #{page} OFFSET #{offset}
    </select>

    <select id="toBeTerminatedListCount" resultType="long">
        select  count(*) from asset_info ai
        <include refid="queryCondition"/>

    </select>

    <sql id="queryCondition">
        <where>
            <if test="isDeleted != null">
                AND ai.is_deleted = #{isDeleted}
            </if>
            <if test="isValid != null">
                AND ai.is_valid = #{isValid}
            </if>
            <if test="status != null">
                AND ai.status = #{status}
            </if>
            <if test="orgUidList != null and orgUidList.size > 0">
                AND (
                ai.institution_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.hospital_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.site_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.clinical_dept_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.asset_dept_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                OR ai.tenant_uid IN
                <foreach item="item" collection="orgUidList" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
                )
            </if>
            <if test="oneSearchStr != null">
                AND (
                  ai.name like concat('%',#{name},'%')
                  or
                  ai.name_py_code like concat('%',#{namePyCode},'%')
                  or
                  ai.depart_num like concat('%',#{departNum},'%')
                or
                ai.financing_num like concat('%',#{financingNum},'%')
                or
                ai.qr_code like concat('%',#{qrCode},'%')

                or
                ai.serial_num like concat('%',#{serialNum},'%')

                or
                ai.manufacture like concat('%',#{manufacture},'%')

                or
                ai.clinical_dept_name like concat('%',#{clinicalDeptName},'%')
                )
            </if>

            <if test="name != null">
                AND ai.name like concat('%',#{name},'%')
            </if>

            <if test="functionType != null">
                AND ai.functionType like concat('%',#{functionType},'%')
            </if>
            <if test="financingNum != null">
                AND ai.financingNum like concat('%',#{financingNum},'%')
            </if>
            <if test="departNum != null">
                AND ai.depart_num = #{departNum}
            </if>
            <if test="makerShortName != null">
                AND ai.make_short_name like concat('%',#{makerShortName},'%')
            </if>


            <if test="vendor != null">
                AND ai.vendor like concat('%',#{vendor},'%')
            </if>

            <if test="usageStatus != null">
                AND ai.usage_status =#{usageStatus}
            </if>
            <if test="terminationCause != null">
                AND ai.termination_cause like concat('%',#{terminationCause},'%')
            </if>
            <if test="assetGroup != null">
                AND ai.asset_group =#{assetGroup}
            </if>
            <if test="mvsEquip != null">
                AND ai.mvs_equip =#{mvsEquip}
            </if>

            <if test="qrCode != null">
                AND ai.qr_code  like concat('%',#{qrCode},'%')
            </if>
            <if test="warrantyDate != null">
                AND ai.warranty_date  ge #{warrantyDate}
            </if>

           <if test="assetDeptOrgUidSet != null">
               AND
               ai.asset_dept_uid IN
               <foreach item="item" collection="assetDeptOrgUidSet" separator="," open="(" close=")" index="">
                   #{item}
               </foreach>
           </if>
            <if test="clinicalDeptOrgUidSet != null">
                AND
                ai.clinical_dept_uid IN
                <foreach item="item" collection="clinicalDeptOrgUidSet" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
            </if>

            <if test="selectSite != null">
                AND (
                ai.institution_uid IN  #{selectSite}
                OR ai.hospital_uid IN   #{selectSite}
                OR ai.site_uid IN   #{selectSite}
                OR ai.clinical_dept_uid IN  #{selectSite}
                )
            </if>
        </where>
    </sql>



</mapper>