<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.UdidDeviceCubeMapper">

    <resultMap id="BaseResultMap" type="com.ge.apm.domain.UdidDeviceCube">
            <result property="registryNum" column="registry_num" jdbcType="VARCHAR"/>
            <result property="registrantName" column="registrant_name" jdbcType="VARCHAR"/>
            <result property="deviceName" column="device_name" jdbcType="VARCHAR"/>
            <result property="devicePattern" column="device_pattern" jdbcType="VARCHAR"/>
            <result property="deviceCategory" column="device_category" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        registry_num
        ,registrant_name,device_name,device_pattern,device_category
    </sql>

    <select id="fuzzySearch" resultType="com.ge.apm.domain.UdidDeviceCube">
        select registry_num, registrant_name, device_name, device_pattern
        from udid_device_cube
        <where>
            <if test="registryNum != null and registryNum != ''">
                and registry_num ilike CONCAT('%', #{registryNum}, '%')
            </if>
            <if test="registrantName != null and registrantName != ''">
                and registrant_name ilike CONCAT('%', #{registrantName}, '%')
            </if>
            <if test="deviceName != null and deviceName != ''">
                and device_name ilike CONCAT('%', #{deviceName}, '%')
            </if>
            <if test="devicePattern != null and devicePattern != ''">
                and device_pattern ilike CONCAT('%', #{devicePattern}, '%')
            </if>
        </where>
    </select>

</mapper>
