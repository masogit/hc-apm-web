<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.UdidRegistryNumInfoMapper">

    <resultMap id="BaseResultMap" type="com.ge.apm.domain.UdidRegistryNumInfo">
        <result property="registryNo" column="registry_no" jdbcType="VARCHAR"/>
        <result property="qxlb" column="qxlb" jdbcType="VARCHAR"/>
        <result property="cplb" column="cplb" jdbcType="VARCHAR"/>
        <result property="cpmctymc" column="cpmctymc" jdbcType="VARCHAR"/>
        <result property="ggxh" column="ggxh" jdbcType="VARCHAR"/>
        <result property="flbm" column="flbm" jdbcType="VARCHAR"/>
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="dbId" column="db_id" jdbcType="VARCHAR"/>
        <result property="registryNum" column="registry_num" jdbcType="VARCHAR"/>
        <result property="registrantName" column="registrant_name" jdbcType="VARCHAR"/>
        <result property="registrantAddress" column="registrant_address" jdbcType="VARCHAR"/>
        <result property="agentName" column="agent_name" jdbcType="VARCHAR"/>
        <result property="agentAddress" column="agent_address" jdbcType="VARCHAR"/>
        <result property="agentRegAddress" column="agent_reg_address" jdbcType="VARCHAR"/>
        <result property="productionAddress" column="production_address" jdbcType="VARCHAR"/>
        <result property="productName" column="product_name" jdbcType="VARCHAR"/>
        <result property="managementCategory" column="management_category" jdbcType="VARCHAR"/>
        <result property="modelSpec" column="model_spec" jdbcType="VARCHAR"/>
        <result property="structureComposition" column="structure_composition" jdbcType="VARCHAR"/>
        <result property="scopeOfUse" column="scope_of_use" jdbcType="VARCHAR"/>
        <result property="storageConditions" column="storage_conditions" jdbcType="VARCHAR"/>
        <result property="attachments" column="attachments" jdbcType="VARCHAR"/>
        <result property="otherContent" column="other_content" jdbcType="VARCHAR"/>
        <result property="remarks" column="remarks" jdbcType="VARCHAR"/>
        <result property="approvalDept" column="approval_dept" jdbcType="VARCHAR"/>
        <result property="approvalDate" column="approval_date" jdbcType="VARCHAR"/>
        <result property="effectiveDate" column="effective_date" jdbcType="VARCHAR"/>
        <result property="validPeriod" column="valid_period" jdbcType="VARCHAR"/>
        <result property="changes" column="changes" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectByRegistryNum" resultType="com.ge.apm.domain.UdidRegistryNumInfo">
        SELECT ta.registry_no,
               ta.qxlb,
               ta.cplb,
               ta.cpmctymc,
               ta.ggxh,
               ta.flbm,
               ta.id,
               ta.db_id,
               ta.registry_num,
               ta.registrant_name,
               ta.registrant_address,
               ta.agent_name,
               ta.agent_address,
               ta.agent_reg_address,
               ta.production_address,
               ta.product_name,
               ta.management_category,
               ta.model_spec,
               ta.structure_composition,
               ta.scope_of_use,
               ta.storage_conditions,
               ta.attachments,
               ta.other_content,
               ta.remarks,
               ta.approval_dept,
               ta.approval_date,
               ta.effective_date,
               ta.valid_period,
               ta.changes,
               tb.is_registration,
               tb.is_domestic,
               ta.created_at,
               ta.updated_at
        FROM udid_registry_num_info AS ta
                 LEFT JOIN udid_db AS tb ON ta.db_id = tb.id
        where registry_num = #{registryNum}
        ORDER BY updated_at DESC
        LIMIT 1
    </select>

    <select id="fuzzySearch" resultType="com.ge.apm.domain.UdidRegistryNumInfo">
        SELECT registry_num, product_name, ggxh, registrant_name, flbm
        FROM udid_registry_num_info
        <where>
            <if test="registryNum != null and registryNum != ''">
                and registry_num ilike CONCAT('%', #{registryNum}, '%')
            </if>
            <if test="manufacture != null and manufacture != ''">
                and registrant_name ilike CONCAT('%', #{manufacture}, '%')
            </if>
            <if test="assetName != null and assetName != ''">
                and product_name ilike CONCAT('%', #{assetName}, '%')
            </if>
            <if test="functionType != null and functionType != ''">
                and ggxh::text ilike CONCAT('%', #{functionType}, '%')
            </if>
        </where>
        ORDER BY registry_num LIMIT 100
    </select>
</mapper>
