<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.MvsTransactionWorkMapper">

<!-- 完整字段映射配置 -->
<resultMap id="eHomeTransactionWorkOrderMap" type="com.ge.apm.domain.EHomeTransactionWorkOrder">
    <id property="id" column="id"/>
    <result property="ucmId" column="ucm_id"/>
    <result property="srId" column="sr_id"/>
    <result property="srNum" column="sr_num"/>
    <result property="totalManHour" column="total_man_hour"/>
    <result property="patProblems" column="pat_problems"/>
    <result property="patActions" column="pat_actions"/>
    <result property="patTests" column="pat_tests"/>
    <result property="status" column="status"/>
    <result property="currentPersonName" column="current_person_name"/>
    <result property="typeKey" column="type_key"/>
    <result property="parentKey" column="parent_key"/>
    <result property="closeTime" column="close_time"/>
    <result property="comment" column="comment"/>
    <result property="srContext" column="sr_context"/>
    <result property="woContext" column="wo_context"/>
    <result property="attachments" column="attachments_context"/>
    <result property="parts" column="parts_context"/>
    <result property="hours" column="hours_context"/>
    <result property="createdBy" column="created_by"/>
    <result property="createdDate" column="created_date"/>
    <result property="modifiedDate" column="modified_date"/>
</resultMap>
    <!-- 查询优化建议 -->
    <select id="loadData" resultMap="eHomeTransactionWorkOrderMap">
        SELECT
            id, ucm_id, sr_id, sr_num,
            total_man_hour, pat_problems, pat_actions, pat_tests,
            status, current_person_name, type_key, parent_key,
            close_time, comment, sr_context, wo_context,
            attachments_context, parts_context, hours_context,
            created_by, created_date, modified_date
        FROM mvs_transaction_work_order
        WHERE 1=1
        <if test="srNum != null">
            and sr_Num like concat('%', #{srNum}, '%')
        </if>
        <if test="status != null ">
            and status = #{status}
        </if>
        <if test="typeKey != null ">
            and type_key = #{typeKey}
        </if>
        <if test="msgKeyArray != null and msgKeyArray.length > 0">
            and  type_key IN
            <foreach item="item" index="index" collection="msgKeyArray" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="woNum != null ">
            and (wo_context::jsonb) ->> 'woNum' like concat('%', #{woNum}, '%')
        </if>
        <if test="ownerName != null ">
            and (wo_context::jsonb) ->> 'ownerName' like concat('%', #{ownerName}, '%')
        </if>
        <if test="faultDesc != null ">
            and (sr_context::jsonb) ->> 'faultDesc' like concat('%', #{faultDesc}, '%')
        </if>
        <if test="customerName != null ">
            and (sr_context::jsonb) ->> 'customerName' like concat('%', #{customerName}, '%')
        </if>
    </select>

</mapper>