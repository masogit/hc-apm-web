<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ge.apm.dao.mapper.SharedAssetReqDetailMapper">

    <resultMap id="sharedAssetReqDetailResult" type="com.ge.apm.domain.SharedAssetReqDetail">
        <id column="id" property="id"/>
        <result column="shared_id" property="sharedId"/>
        <result column="borrow_id" property="borrowId"/>
        <result column="return_id" property="returnId"/>
        <result column="asset_info_id" property="assetInfoId"/>
        <result column="shared_asset_type" property="sharedAssetTypeId"/>
        <result column="asset_number" property="assetNumber"/>
        <result column="asset_name" property="assetName"/>
        <result column="unit" property="unit"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="charging_type" property="chargingType"/>
        <result column="state" property="state"/>
        <result column="charging_begin_time" property="chargingBeginTime"/>
        <result column="charging_end_time" property="chargingEndTime"/>
        <result column="count_qty" property="countQty"/>
        <result column="patient_num" property="patientNum"/>
        <result column="cost" property="cost"/>
        <result column="accepter" property="accepter"/>
        <result column="financing_num" property="financingNum"/>
        <result column="remark" property="remark"/>
        <result column="tenant_uid" property="tenantUID"/>
        <result column="institution_uid" property="institutionUID"/>
        <result column="hospital_uid" property="institutionUID"/>
        <result column="site_uid" property="siteUID"/>
        <result column="clinical_dept_uid" property="clinicalDeptUid"/>
        <result column="clinical_dept_name" property="clinicalDeptName"/>
        <result column="starting_price" property="startingPrice"/>
        <result column="starting_duration" property="startingDuration"/>
        <result column="gratis_duration" property="gratisDuration"/>
        <result column="discount_start_date" property="discountStartDate"/>
        <result column="discount_end_date" property="discountEndDate"/>
        <result column="discount" property="discount"/>
        <result column="compensation_amount" property="compensationAmount"/>
        <result column="patient_num" property="patientNum"/>
        <result column="patient_bed_num" property="patientBedNum"/>
        <result column="swap_index" property="swapIndex"/>
        <result column="function_type" property="functionType"/>
        <result column="brand_name" property="brandName"/>
        <result column="swap_name" property="swapName"/>
        <result column="qr_code" property="qrCode"/>
        <result column="signature_id" property="signatureId"/>
        <result column="signatory" property="signatory"/>
        <result column="signature_time" property="signatureTime"/>
        <result column="borrow_deal_name" property="borrowDealName"/>
    </resultMap>
    <sql id="selectSql">
        select
                sard.id,
                sard.borrow_id,
                sard.return_id,
                sard.asset_info_id,
                sard.shared_asset_type,
                sard.asset_number,
                sard.asset_name,
                sard.unit,
                sard.unit_price,
                sard.charging_type,
                sard.charging_begin_time,
                sard.charging_end_time,
                sard.count_qty,
                sard.tenant_uid,
                sard.institution_uid,
                sard.hospital_uid,
                sard.site_uid,
                sard.clinical_dept_uid,
                sard.clinical_dept_name,
                sard.starting_price,
                sard.starting_duration,
                sard.gratis_duration,
                sard.discount_start_date,
                sard.discount_end_date,
                sard.discount,
                sard.is_cleaned,
                sard.compensation_amount,
                sard.patient_num,
                sard.patient_bed_num,
                sard.qr_code,
                sasi.swap_index,
                sasi.remark,
                (case
                when  sard.charging_end_time is not null and sard.is_cleaned=true then '已完成'
                when  sard.charging_end_time is not null and sard.is_cleaned != true then '已归还（未清洁保养）'
                when	 bsar.state = 6 and  sard.charging_end_time is null then '使用中'
                when  bsar.state = 3 then '已预约'
                else ''
                end) state,
                ai.function_type,
                ai.make_short_name as brand_name,
                sat.swap_name,
                bsarr.signature_id,
                bsarr.signatory,
                bsarr.signature_time,
                ua_borrow_deal.name as borrow_deal_name
                from  shared_asset_req_detail sard
                left join shared_asset_request bsar on bsar.id=sard.borrow_id
                left join shared_asset_swap_index sasi on sard.asset_info_id = sasi.asset_uid
                left join asset_info ai on ai.uid=sard.asset_info_id
                left join shared_asset_type  sat on ai.shared_asset_type=sat.id
                left join shared_asset_request bsarr on bsarr.id=sard.return_id
                left join user_account ua_borrow_deal on ua_borrow_deal.uid=sard.borrow_deal_uid
    </sql>
    <select id="getTotalRowCount" resultType="int">
            select count(distinct id) from (
               <include refid="selectSql" />
            ) t1
        <where>${ew.sqlSegment}</where>
    </select>

    <select id="loadSharedAssets" resultMap="sharedAssetReqDetailResult">
        select * from (
          <include refid="selectSql" />
        ) t1
        <where>${ew.sqlSegment}</where>
    </select>

</mapper>