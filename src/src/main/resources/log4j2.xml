<?xml version="1.0" encoding="UTF-8"?>
<configuration status="OFF" strict="true">
  <appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}[%t]%-5level %logger{12} - %msg%n"/>
    </Console>

    <RollingFile name="File" fileName="logs/logFile-hc-apm-web.log"
                 filePattern="logs/logFile-hc-apm-web-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}[%t]%-5level %logger{12} - %msg%n" charset="UTF-8"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="50MB"/>
      </Policies>
      <DefaultRolloverStrategy max="30">
        <Delete basePath="logs" maxDepth="1">
          <IfFileName glob="logFile-hc-apm-web-*.log.gz"/>
          <IfAccumulatedFileSize exceeds="5GB"/>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
  </appenders>

  <loggers>
    <root additivity="false" level="info">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </root>
    <logger name="com.demo" additivity="false" level="${log4j.level}">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="com.ge.apm.view" additivity="false" level="info">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="com.demo.dao" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="webapp.framework.web.filter" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.springframework.transaction" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.springframework.orm.hibernate3" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.hibernate.cache.EhCacheProvider" additivity="false" level="error">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.hibernate" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.springframework.security" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.apache.commons" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.springframework" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="org.springframework.beans.factory.support" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="net.sf.ehcache" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="druid.sql" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="druid.sql.DataSource" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="druid.sql.Connection" additivity="false" level="warn">
      <appender-ref ref="Console"/>
    </logger>
    <logger name="druid.sql.Statement" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <logger name="druid.sql.ResultSet" additivity="false" level="warn">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
    <!-- === PRD 降噪：getColumnNameList ERROR 抑制 === -->
    <logger name="webapp.framework.web.mvc.JpaCRUDController" additivity="false" level="fatal">
      <appender-ref ref="Console"/>
      <appender-ref ref="File"/>
    </logger>
  </loggers>
</configuration>